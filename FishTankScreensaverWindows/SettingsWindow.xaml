<Window x:Class="FishTankScreensaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fish Tank Screensaver Options"
        Width="420" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Fish Tank Screensaver"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#333333" />

        <!-- Background Color -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Background Color:"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    x:Name="ColorPreview"
                    Width="50" Height="30"
                    BorderBrush="#999999" BorderThickness="1"
                    CornerRadius="3"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    MouseLeftButtonUp="ColorPreview_Click" />
            <TextBox Grid.Column="2"
                     x:Name="ColorHexBox"
                     Width="80" Height="28"
                     Margin="10,0,0,0"
                     VerticalContentAlignment="Center"
                     MaxLength="7"
                     TextChanged="ColorHexBox_TextChanged" />
        </Grid>

        <!-- Fish Count -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Number of Fish:"
                       VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    x:Name="FishCountSlider"
                    Minimum="1" Maximum="100"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="FishCountSlider_ValueChanged" />
            <TextBlock Grid.Column="2"
                       x:Name="FishCountLabel"
                       Text="50"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- Sort Type -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Fish Sorting:"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      x:Name="SortTypeCombo"
                      Height="28"
                      HorizontalAlignment="Left"
                      Width="180">
                <ComboBoxItem Content="Most Recent" Tag="recent" />
                <ComboBoxItem Content="Most Popular" Tag="popular" />
                <ComboBoxItem Content="Random" Tag="random" />
            </ComboBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="85" Height="30"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button Content="OK"
                    Width="85" Height="30"
                    IsDefault="True"
                    Click="OK_Click" />
        </StackPanel>
    </Grid>
</Window>
