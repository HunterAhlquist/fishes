<Window x:Class="FishTankScreensaver.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fish Tank Screensaver"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="Black"
        Cursor="None">
    <Grid>
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="Transparent" />
        <!-- Transparent overlay to intercept all mouse input before WebView2 -->
        <Grid x:Name="InputOverlay"
              Background="Transparent"
              MouseDown="Overlay_MouseDown"
              MouseMove="Overlay_MouseMove"
              MouseWheel="Overlay_MouseWheel" />
        <!-- Loading overlay shown while WebView2 initializes -->
        <Grid x:Name="LoadingOverlay" Background="#FF0E1C2A">
            <TextBlock Text="Loading Fish Tank..."
                       Foreground="#80FFFFFF"
                       FontSize="24"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
